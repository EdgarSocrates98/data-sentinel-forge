{
  "$defs": {
    "DatasetReference": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "default": "",
          "title": "Account",
          "type": "string"
        },
        "catalog": {
          "default": "",
          "title": "Catalog",
          "type": "string"
        },
        "identifier": {
          "default": "",
          "title": "Identifier",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "platform": {
          "default": "",
          "title": "Platform",
          "type": "string"
        },
        "region": {
          "default": "",
          "title": "Region",
          "type": "string"
        },
        "version": {
          "default": "",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name"
      ],
      "title": "DatasetReference",
      "type": "object"
    },
    "ObservationStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "WARN",
        "UNKNOWN"
      ],
      "title": "ObservationStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A normalized, observed quality measurement (\u00a74.5).",
  "properties": {
    "dataset": {
      "anyOf": [
        {
          "$ref": "#/$defs/DatasetReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_value": {
      "default": null,
      "title": "Expected Value"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metric_name": {
      "default": "",
      "title": "Metric Name",
      "type": "string"
    },
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "observed_value": {
      "default": null,
      "title": "Observed Value"
    },
    "provenance": {
      "default": "",
      "title": "Provenance",
      "type": "string"
    },
    "rule_id": {
      "default": "",
      "title": "Rule Id",
      "type": "string"
    },
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "source": {
      "default": "",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ObservationStatus",
      "default": "UNKNOWN"
    },
    "timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timestamp"
    },
    "unit": {
      "default": "",
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "observation_id"
  ],
  "title": "QualityObservation",
  "type": "object"
}
