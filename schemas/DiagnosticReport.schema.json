{
  "$defs": {
    "Environment": {
      "additionalProperties": false,
      "description": "Environment a workload ran in.",
      "properties": {
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Details",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "required": [
        "name"
      ],
      "title": "Environment",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "An evidence-backed diagnostic conclusion (\u00a74).",
      "properties": {
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "validation_steps": {
          "items": {
            "type": "string"
          },
          "title": "Validation Steps",
          "type": "array"
        }
      },
      "required": [
        "category",
        "severity",
        "status",
        "explanation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingCategory": {
      "description": "Classification of a finding's technical domain.",
      "enum": [
        "out_of_memory",
        "disk_space",
        "data_skew",
        "configuration",
        "permissions",
        "network_io",
        "dependency",
        "timeout",
        "executor_loss",
        "sql_antipattern",
        "data_quality",
        "cost",
        "security",
        "unknown"
      ],
      "title": "FindingCategory",
      "type": "string"
    },
    "FindingStatus": {
      "description": "Certainty taxonomy for findings (\u00a72.1).",
      "enum": [
        "CONFIRMED",
        "PROBABLE",
        "POSSIBLE",
        "UNKNOWN"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Severity": {
      "description": "Impact severity of a finding or recommendation.",
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned output contract aggregating findings (\u00a74).",
  "properties": {
    "analyzer_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Analyzer Versions",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "environment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Environment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "references": {
      "items": {
        "type": "string"
      },
      "title": "References",
      "type": "array"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "created_at"
  ],
  "title": "DiagnosticReport",
  "type": "object"
}
