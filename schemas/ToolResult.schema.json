{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "default": 0.0,
      "title": "Duration Ms",
      "type": "number"
    },
    "error": {
      "default": "",
      "title": "Error",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "invocation_id": {
      "minLength": 1,
      "title": "Invocation Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "output": {
      "default": null,
      "title": "Output"
    },
    "tool_id": {
      "default": "",
      "title": "Tool Id",
      "type": "string"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "invocation_id",
    "ok"
  ],
  "title": "ToolResult",
  "type": "object"
}
