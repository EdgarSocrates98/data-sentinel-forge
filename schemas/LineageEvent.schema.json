        "$ref": "#/$defs/DatasetReference"
      },
      "title": "Inputs",
      "type": "array"
    },
    "job": {
      "additionalProperties": true,
      "title": "Job",
      "type": "object"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/DatasetReference"
      },
      "title": "Outputs",
      "type": "array"
    },
    "provenance": {
      "default": "",
      "title": "Provenance",
      "type": "string"
    },
    "run": {
      "additionalProperties": true,
      "title": "Run",
      "type": "object"
