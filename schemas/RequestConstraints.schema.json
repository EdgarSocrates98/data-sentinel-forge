{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Limits the caller imposes on the analysis.",
  "properties": {
    "allowed_roots": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Roots",
      "type": "array"
    },
    "max_file_bytes": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max File Bytes"
    },
    "timeout_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeout Seconds"
    }
  },
  "title": "RequestConstraints",
  "type": "object"
}
